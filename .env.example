# Coalesce Quality credentials.
#
# Not required if you authenticate with a browser login instead:
#   synq-google-cloud-storage auth login
# which caches a credential shared with the other Coalesce Quality tools.
#
# The SYNQ_-prefixed spellings of every variable below are still read.
QUALITY_CLIENT_ID=your_client_id_here
QUALITY_CLIENT_SECRET=your_client_secret_here

# A pre-issued access token, instead of a client credential pair.
# QUALITY_TOKEN=

# Deployment. Defaults to the EU region, or to the one you last logged into.
# QUALITY_REGION=us
# QUALITY_API_ENDPOINT=api.us.synq.io:443

# GCP Project ID (optional - auto-detected if not set)
# Auto-detection sources (in order of precedence):
#   1. GCP_PROJECT_ID env var (this file)
#   2. GOOGLE_CLOUD_PROJECT env var
#   3. GCLOUD_PROJECT env var (legacy)
#   4. gcloud CLI config (gcloud config get-value project)
#   5. GCP metadata server (when running on GCP)
#   6. config.yaml
# GCP_PROJECT_ID=your-gcp-project-id
