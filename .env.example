# SYNQ API Credentials (required)
# Get these from your SYNQ account
SYNQ_CLIENT_ID=your_client_id_here
SYNQ_CLIENT_SECRET=your_client_secret_here

# GCP Project ID (optional - auto-detected if not set)
# Auto-detection sources (in order of precedence):
#   1. GCP_PROJECT_ID env var (this file)
#   2. GOOGLE_CLOUD_PROJECT env var
#   3. GCLOUD_PROJECT env var (legacy)
#   4. gcloud CLI config (gcloud config get-value project)
#   5. GCP metadata server (when running on GCP)
#   6. config.yaml
# GCP_PROJECT_ID=your-gcp-project-id
