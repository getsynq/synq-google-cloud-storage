# Coalesce Quality configuration.
#
# Everything here is optional. The deployment defaults to the EU region, or to
# the one you last logged into, and credentials normally come from the
# environment or from `synq-google-cloud-storage auth login`.
quality:
  # region: "us"                      # eu, us or au
  # endpoint: "api.us.synq.io:443"    # overrides region
  # client_id: ""                     # prefer QUALITY_CLIENT_ID
  # client_secret: ""                 # prefer QUALITY_CLIENT_SECRET
  # token: ""                         # a pre-issued access token

# The `synq:` section this replaced is still read, and its values are used for
# anything `quality:` leaves unset.

# GCP Configuration
gcp:
  project_id: "my-gcp-project"
  user_agent: "synq-pubsub-client-v1.0.0"
  # Entity group ID for tracking resources (defaults to pubsub::<project_id>)
  # entity_group_id: "pubsub::custom-group-id"

# Custom Entity Type IDs
types:
  topic_type_id: 20
  subscription_type_id: 21
  # Optional: Custom icon paths (defaults to embedded icons/pubsub.svg)
  # topic_icon: "path/to/custom-topic-icon.svg"
  # subscription_icon: "path/to/custom-subscription-icon.svg"

# Resource Filters
filter:
  # Topic filters
  topics:
    include: []  # Empty means include all
    exclude: []  # Patterns to exclude

  # Subscription filters
  subscriptions:
    include: []  # Empty means include all
    exclude:
      # Exclude auto-generated per-pod subscriptions
      - '-[a-z0-9]{9,10}-[a-z0-9]{5}\.subscription$'

# Relationship Management
relationships:
  enabled: false  # Set to true to enable bucket->topic relationships for Pub/Sub notifications
  filter:
    include: []  # Empty means include all (format: "bucket_name->topic_id")
    exclude: []  # Regex patterns to exclude relationship pairs
    # Examples:
    # include: ["important-bucket->.*"]  # Only create relationships for important-bucket
    # exclude: ["test-.*->.*"]           # Skip relationships for test buckets
